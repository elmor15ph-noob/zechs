# DUO Brain App — Channel Integration Tokens
# Copy to .env.channels, fill in your values, DO NOT commit to git.

DUO_API_URL=http://localhost:8000
OPENCLAW_ENABLED=true
DEFAULT_PERSONA=zero

# Discord — https://discord.com/developers/applications → Bot → Reset Token
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Slack — https://api.slack.com/apps (see slack_bot.md)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# Telegram — @BotFather on Telegram: /newbot
TELEGRAM_BOT_TOKEN=
