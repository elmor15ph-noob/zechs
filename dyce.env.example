# Dyce Brain — Corporate VM Environment Template
# Copy to: backend/.env (on your VM)
# DO NOT commit the filled-in version.
#
# Dyce runs on a corporate VM: CLI only, no Discord/Slack, no web UI.
# Point DUO_API_URL at your laptop (running the FastAPI backend) over LAN/VPN.

# ── Backend connection ────────────────────────────────────────────────────────
# If running the backend on THIS VM:
DUO_API_URL=http://localhost:8000

# If connecting to Jay's laptop backend over LAN/VPN:
# DUO_API_URL=http://192.168.x.x:8000

# ── Your vault path ───────────────────────────────────────────────────────────
VAULT_PATH=C:/Users/YourName/Documents/YourVault

# ── Your name (shown in logs) ─────────────────────────────────────────────────
DYCE_USER=your-name

# ── LLM provider ─────────────────────────────────────────────────────────────
# Option A: Corporate LLM (near-unlimited tokens — use for deep reasoning)
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b

# Option B: Corporate Azure OpenAI endpoint (if available)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-corp-key
# OPENAI_API_BASE=https://your-corp-azure-openai.openai.azure.com/

# Option C: Anthropic (personal key — check corp policy)
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...

# ── Agent kill switches ───────────────────────────────────────────────────────
# Disable agents you don't need on the VM
AGENT_INBOX_ENABLED=true
AGENT_SYNTHESIS_ENABLED=true
AGENT_SAP_ENABLED=true
AGENT_O2C_ENABLED=false        # disable if not doing order processing
AGENT_LLM_KPI_ENABLED=false    # disable if not tracking LLM costs

# ── Cost caps (per agent, per day in USD) ─────────────────────────────────────
AGENT_INBOX_DAILY_CAP=1.0
AGENT_SYNTHESIS_DAILY_CAP=2.0
AGENT_SAP_DAILY_CAP=2.0
